# Google Gemini (100% Free - Get key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# OpenAI (Optional - Paid)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# bdapps TAP API (Optional - Leave empty for built-in simulation)
BDAPPS_APP_ID=
BDAPPS_PASSWORD=
BDAPPS_BASE_URL=https://developer.bdapps.com
